Options -Indexes
RewriteEngine On

# ── HTTPS Zorla (aktif et: hosting'de SSL varsa # kaldır) ─────
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Gerçek dosya/dizin varsa dokunma ─────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ════════════════════════════════════════════════
# URL ROTALARI
# ════════════════════════════════════════════════

RewriteRule ^$                           public/index.php            [QSA,L]
RewriteRule ^home/?$                     public/index.php            [QSA,L]
RewriteRule ^signup/?$                   public/index.php?signup=1   [QSA,L]

RewriteRule ^setup/?$                    install/index.php           [QSA,L]

RewriteRule ^search/?$                   app/search/index.php        [QSA,L]
RewriteRule ^profile/([a-z0-9_]+)/?$    app/search/profile.php?u=$1 [QSA,L]

RewriteRule ^messages/?$                 app/messages/index.php      [QSA,L]
RewriteRule ^dm/([a-z0-9_]+)/?$         app/dm/index.php?with=$1    [QSA,L]
RewriteRule ^notifications/?$            app/notifications/index.php [QSA,L]
RewriteRule ^settings/?$                 app/settings/index.php      [QSA,L]
RewriteRule ^reset/?$                    app/reset/index.php         [QSA,L]
RewriteRule ^stats/?$                    app/static/user.php         [QSA,L]
RewriteRule ^api-docs/?$                 app/static/api.php          [QSA,L]

# ── Scraper-style API (key gerekmez, JSON döner) ─────────────
RewriteRule ^app/api/users\.php$         app/api/users.php           [QSA,L]
RewriteRule ^app/api/tweet\.php$         app/api/tweet.php           [QSA,L]
RewriteRule ^api/users/users\.php$       app/api/users.php           [QSA,L]
RewriteRule ^api/tweet/tweet\.php$       app/api/tweet.php           [QSA,L]

# ════════════════════════════════════════════════
# GÜVENLİK: HASSAS DOSYALARI ENGELLE
# ════════════════════════════════════════════════

# Config, SMTP, veritabanı şemaları direkt erişilemez
RewriteRule ^app/config\.php$           - [F,L]
RewriteRule ^app/smtp/                  - [F,L]
RewriteRule ^install/                   - [F,L]
RewriteRule ^SQL/                       - [F,L]

# Git, composer, env dosyaları
RewriteRule ^\.git                      - [F,L]
RewriteRule ^composer\.(json|lock)$     - [F,L]
RewriteRule ^package(-lock)?\.json$     - [F,L]

# Hassas uzantılar
RewriteRule \.(sql|env|bak|log|sh|ini|htpasswd)$ - [F,L]

# app/ klasörüne direkt PHP erişimini kapat
# (sadece .htaccess rötaları üzerinden erişilebilir)
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /app/(?!api/).*\.php [NC]
RewriteRule ^ - [F,L]

# ── Path Traversal koruması ───────────────────────────────────
RewriteCond %{QUERY_STRING} (\.\.\/|\.\.%2F|%00) [NC]
RewriteRule ^ - [F,L]

# ── SQL Injection query string koruması ──────────────────────
RewriteCond %{QUERY_STRING} (union\s+select|information_schema|load_file|into\s+outfile) [NC]
RewriteRule ^ - [F,L]

# ── Scanner / kötü bot engeli ─────────────────────────────────
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|burpsuite|dirbuster|gobuster|acunetix|nessus|openvas) [NC]
RewriteRule ^ - [F,L]

# Boş user-agent engelle (sadece API dışı)
RewriteCond %{HTTP_USER_AGENT} ^$ [NC]
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteRule ^ - [F,L]

# ════════════════════════════════════════════════
# GÜVENLİK BAŞLIKLARI
# ════════════════════════════════════════════════

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options   "nosniff"
    Header always set X-Frame-Options          "SAMEORIGIN"
    Header always set X-XSS-Protection         "1; mode=block"
    Header always set Referrer-Policy          "strict-origin-when-cross-origin"
    Header always set Permissions-Policy       "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy  "default-src 'self' https: data:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src * data:; connect-src 'self';"
    # API yanıtları için CORS
    Header always set Access-Control-Allow-Origin "*" "expr=%{REQUEST_URI} =~ m#^/api/#"
</IfModule>

# ── PHP hata kapatma (prodüksiyon) ───────────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors     On
    php_value error_log     /tmp/geminy_errors.log
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors     On
    php_value error_log     /tmp/geminy_errors.log
</IfModule>

# ── İstek boyutu limiti ───────────────────────────────────────
<IfModule mod_security.c>
    SecRequestBodyLimit 2097152
</IfModule>

# ── Önbellek: statik assets ───────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css         "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png        "access plus 30 days"
    ExpiresByType image/jpeg       "access plus 30 days"
    ExpiresByType image/webp       "access plus 30 days"
</IfModule>
